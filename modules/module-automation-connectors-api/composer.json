{
  "name": "liberusoftware/module-automation-connectors-api",
  "description": "HTTP API adapter for module-automation-connectors.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/support": "^13.0",
    "laravel/framework": "^13.0",
    "liberusoftware/module-automation-connectors": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Modules\\Automation\\Connectors\\Api\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "module-automation-connectors-api"
    }
  },
  "version": "1.0.0",
  "require-dev": {
    "pestphp/pest": "^5.0"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
