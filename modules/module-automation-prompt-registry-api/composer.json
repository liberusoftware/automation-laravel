{
  "name": "liberusoftware/automation-prompt-registry-api",
  "description": "HTTP API adapter for module-automation-prompt-registry.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/support": "^13.0",
    "laravel/framework": "^13.0",
    "liberusoftware/automation-prompt-registry": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Modules\\Automation\\PromptRegistry\\Api\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "module-automation-prompt-registry-api"
    }
  },
  "require-dev": {
    "pestphp/pest": "^5.0"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
