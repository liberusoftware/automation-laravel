{
  "name": "liberusoftware/automation-video-livewire",
  "description": "Livewire 4 adapter for module-automation-video.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "livewire/livewire": "^4.0",
    "liberusoftware/automation-video": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Modules\\Automation\\Video\\Livewire\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "module-automation-video-livewire"
    }
  },
  "require-dev": {
    "pestphp/pest": "^5.0"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
