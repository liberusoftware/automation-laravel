{
  "name": "liberusoftware/automation-rules-filament",
  "description": "Filament 5 adapter for module-automation-rules.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "filament/filament": "^5.1",
    "liberusoftware/automation-rules": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Modules\\Automation\\Rules\\Filament\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "module-automation-rules-filament"
    }
  },
  "require-dev": {
    "pestphp/pest": "^5.0"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
