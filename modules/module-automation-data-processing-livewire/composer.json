{
  "name": "liberusoftware/module-automation-data-processing-livewire",
  "description": "Livewire 4 adapter for module-automation-data-processing.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "livewire/livewire": "^4.0",
    "liberusoftware/module-automation-data-processing": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Modules\\Automation\\DataProcessing\\Livewire\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "module-automation-data-processing-livewire"
    }
  },
  "version": "1.0.0",
  "require-dev": {
    "pestphp/pest": "^5.0"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
